PORT=5000
CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-this-to-something-random
TIMEZONE=Asia/Kolkata

# Gnani API key (app.gnani.ai -> API keys)
GNANI_API_KEY=

# Speech to text
STT_MODEL=prisma-v2.5
STT_LANGUAGE=hi-IN

# Text to speech
TTS_MODEL=timbre-v2.5
TTS_VOICE=Nalini
TTS_LANGUAGE=hi-en

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client (Web application)
# Add the redirect URI below to "Authorized redirect URIs"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
